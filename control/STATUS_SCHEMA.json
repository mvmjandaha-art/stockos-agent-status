{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockOS Sanitized Agent Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "role",
    "timestamp_ist",
    "status",
    "blueprint_identity",
    "candidate_identity",
    "completed_work",
    "test_results",
    "blockers",
    "artifact_paths",
    "artifact_sha256",
    "artifact_size",
    "verdict",
    "next_action",
    "stop_here",
    "blueprint_ratified",
    "implementation_authorized",
    "shadow_authorized",
    "paper_authorized",
    "live_authorized"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"enum": ["CODEX", "CLAUDE", "GROK", "OWNER_ARCHITECT"]},
    "role": {"type": "string", "minLength": 1},
    "timestamp_ist": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "OWNER_APPROVED",
        "READY_FOR_CODEX",
        "CODEX_CLAIMED",
        "CODEX_RUNNING",
        "READY_FOR_CLAUDE",
        "CLAUDE_RUNNING",
        "REMEDIATION_REQUIRED",
        "READY_FOR_OWNER_ARCHITECT",
        "BLOCKED",
        "SUPERSEDED",
        "CLOSED",
        "WAITING_FOR_ELIGIBLE_TASK"
      ]
    },
    "blueprint_identity": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "string", "minLength": 1},
    "completed_work": {"type": "string"},
    "test_results": {"type": "string"},
    "blockers": {"type": "string"},
    "artifact_paths": {"type": "array", "items": {"type": "string"}},
    "artifact_sha256": {"type": "array", "items": {"type": "string"}},
    "artifact_size": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "verdict": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "stop_here": {"type": "string", "minLength": 1},
    "blueprint_ratified": {"const": false},
    "implementation_authorized": {"const": false},
    "shadow_authorized": {"const": false},
    "paper_authorized": {"const": false},
    "live_authorized": {"const": false},
    "claim_id": {"type": "string"},
    "claim_expires_at": {"type": "string"}
  }
}
